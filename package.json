{
  "name": "device-monitor",
  "version": "0.1.0",
  "description": "Vendor-neutral meeting room and UC device monitoring across Teams, Webex, Zoom and Google Meet estates.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "loadtest": "node test/load/run.js",
    "test:pg": "node --test test/postgres.test.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "pg": "8.23.1"
  }
}
