# Copy to .env (never commit .env). All values are optional for the mock demo.

# 32-byte key (64 hex chars) used to encrypt OEM API credentials at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated on first run and saved to data/master.key (outside source control).
MASTER_KEY=

PORT=8080

# Password for the seeded demo users (provider admin + one user per customer).
DEMO_PASSWORD=demo1234

# Seconds between connector sync runs.
SYNC_INTERVAL_SECONDS=30

# Where the encrypted store lives.
DATA_DIR=./data
