# Copy to .env (never commit .env). All values are optional for a local demo.

# Encrypts OEM API credentials at rest. 64 hex characters, or any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated on first run and saved to data/master.key (outside source control).
MASTER_KEY=

PORT=8080

# Password for superadmin@provider.example (customer onboarding). Defaults to DEMO_PASSWORD locally.
SUPERADMIN_PASSWORD=

# Password for the seeded demo users (provider admin + one user per demo customer).
DEMO_PASSWORD=demo1234

# Show the demo accounts on the sign-in page (default: true locally, false when NODE_ENV=production).
SHOW_DEMO_ACCOUNTS=

# Starting default for how often each connection syncs, in seconds (60 to 86400,
# default 300). Once the super admin sets a default under Configure > Sync
# schedule, that wins. Each connection can also have its own interval there.
# SYNC_INTERVAL_SECONDS=300
# How many connections may sync at the same time (default 4), and how long one
# sync may run before it is abandoned and retried (default 120 seconds).
# SYNC_CONCURRENCY=4
# SYNC_TIMEOUT_SECONDS=120

# Storage. With DATABASE_URL set, everything is kept in Postgres (needed for
# large estates); an existing data/ folder is imported on the first start.
# Without it, JSON files in DATA_DIR are used (fine for a demo or small estate).
# DATABASE_URL=postgres://user:password@host:5432/estate
# PG_POOL_MAX=5

# Where the file store, uploaded room documents and the generated master key live.
DATA_DIR=./data

# Retention: alerts kept (newest first) and their maximum age, and days of health history for SLA reports.
# ALERT_MAX=10000
# ALERT_RETENTION_DAYS=30
# HISTORY_RETENTION_DAYS=35

# Map tiles. The map uses OpenStreetMap's own tiles by default, with a
# "Light" alternative (CARTO, OpenStreetMap data). To use your own open tile
# server (e.g. a self-hosted OpenMapTiles or tileserver-gl), set:
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# MAP_TILE_NAME=Company map
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# API tracker: minutes between automatic reachability checks of every
# external API (0 turns automatic checks off; the super admin can still run them).
# API_CHECK_MINUTES=30
